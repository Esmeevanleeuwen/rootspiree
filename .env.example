# SQLite database used by the app and admin setup.
DATA_PATH=./data/rootspiree.sqlite

# Address for npm start. The Vite development server prints its own URL.
HOST=127.0.0.1
PORT=4173

# For public hosting behind an HTTPS proxy, set APP_ORIGIN to your full
# public origin, without a trailing slash, and set SECURE_COOKIES=true.
# APP_ORIGIN=https://game.example.com
SECURE_COOKIES=false

# First admin account. Leave email and password blank to enter them when
# running npm run admin:create. For unattended setup, fill both in locally.
ADMIN_NAME="Game Master"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
